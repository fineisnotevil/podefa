import { Palette } from "std-widgets.slint";

// The design tokens of both themes (Plan 0007 §4, from the concept's DESIGN.md §5). Everything
// the window draws itself takes its colours from here; the std-widgets (buttons, fields, lists)
// follow `Palette`, whose colour scheme the window sets from the user's choice.
//
// Dark is one neutral surface ladder, each step lighter the nearer it is to the user:
//   shell #141416 (recessed fields), canvas #1c1c1f (behind the pages), surface #2b2b30 (islands,
//   popups), line-strong and hover #36363b, active #4a4a51.
// Light keeps the concept's grey canvas under white surfaces.
export global Theme {
    // Whether the dark tokens apply. Follows the window's colour scheme; when the user picks
    // "System", `Palette.color-scheme` is `unknown` and the std-widgets style decides on its own,
    // so this reads the style's background, which is #1C1C1C in the Fluent style's dark scheme
    // (i-slint-compiler-1.18.1/widgets/fluent/styling.slint:18-22, 36).
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark
        || (Palette.color-scheme == ColorScheme.unknown && Palette.background == #1c1c1c);

    // Surfaces, from the back of the window to the front.
    out property <color> shell: dark ? #141416 : #f4f4f5;
    out property <color> canvas: dark ? #1c1c1f : #eceff3;
    out property <color> surface: dark ? #2b2b30 : #ffffff;
    // The islands over the canvas: the surface at 92%, enough for the pages to show through at
    // the edges without the text over them losing contrast; no blur (the renderers have none).
    out property <color> surface-float: dark ? #2b2b30eb : #ffffffeb;
    out property <color> hover: dark ? #36363b : #f4f4f5;
    out property <color> active: dark ? #4a4a51 : #e4e4e7;

    // Lines: hairlines between parts of a surface, and the edge of a surface over the canvas.
    out property <color> line: dark ? #ffffff14 : #00000014;
    out property <color> line-strong: dark ? #36363b : #d4d4d8;

    // Text.
    out property <color> text: dark ? #f4f4f5 : #18181b;
    out property <color> text-muted: dark ? #a1a1aa : #52525b;
    out property <color> text-faint: dark ? #71717a : #a1a1aa;

    // The accent: selection, the current item, focus. The concept is neutral; the app keeps the
    // style's accent so focus stays visible against both themes.
    out property <brush> accent: Palette.accent-background;
    out property <brush> selection: Palette.selection-background;
    out property <brush> selection-text: Palette.selection-foreground;

    // States.
    out property <color> danger: dark ? #f87171 : #b42318;
    out property <color> danger-surface: dark ? #3b1d1d : #fde8e8;
    out property <color> danger-line: dark ? #7f2d2d : #f8b4b4;
    out property <color> danger-text: dark ? #fecaca : #9b1c1c;

    // Popup shadow; the software renderer draws none, so a popup also keeps its line-strong edge.
    out property <color> shadow: dark ? #00000080 : #00000040;

    // Islands (Plan 0007 Phase 2): their edge, their shadow (femtovg caches it; the software
    // renderer draws none, and the surface ladder still sets them apart), the keyboard focus ring,
    // and the close button's red under the pointer.
    out property <color> island-line: dark ? #ffffff14 : #0000000f;
    out property <color> island-shadow: dark ? #00000066 : #0000001f;
    out property <brush> focus: Palette.accent-background;
    out property <color> danger-fill: dark ? #dc2626 : #e5484d;
    // The window's edge while it is not maximized: a frameless window has no system border.
    out property <color> window-edge: dark ? #36363b : #c4c4cc;

    // The modes (Plan 0007 Phase 3). Edit lays a dot grid over a slightly darker canvas; Tools
    // is a "typesetting desk": dots, lines, ruler ticks and a raised stone under the pages. The
    // grids are textures coloured with these, each a little fainter in dark (DESIGN.md step 36).
    out property <color> canvas-edit: dark ? #1c1c1f : #e6e7ea;
    out property <color> grid-dot: dark ? #ffffff1c : #00000040;
    out property <color> desk: dark ? #1a1a1d : #eaecef;
    out property <color> desk-ink: dark ? #ffffff1a : #18181b38;
    out property <color> ruler: dark ? #ffffff12 : #a1a1aa36;
    out property <color> stone: dark ? #ffffff08 : #f4f4f580;
    out property <color> stone-line: dark ? #3f3f4699 : #d4d4d899;
    // A page in the gallery: chosen, under the pointer, and the check box on it.
    out property <color> card-chosen: dark ? #27272a99 : #e4e4e780;
    out property <color> card-ring: dark ? #a1a1aa : #27272a;
    out property <color> card-hover-ring: #71717a;
    out property <color> check-fill: dark ? #d4d4d8 : #18181b;
    out property <color> check-mark: dark ? #09090b : #ffffff;
    // The active markup tools carry their ink's colour (the concept's amber and rose).
    out property <color> highlight-fill: #fbbf2440;
    out property <color> highlight-ink: dark ? #fbbf24 : #b45309;
    out property <color> strike-fill: #f43f5e33;
    out property <color> strike-ink: dark ? #fb7185 : #be123c;
    out property <color> ink-fill: dark ? #52525b : #18181b;

    // Motion (plan §1: at most 250 ms). A mode change and pages sliding aside take `motion`; a
    // palette pours out its swatches over `pour`, one `pour-step` after another.
    out property <duration> motion: 250ms;
    out property <duration> pour: 220ms;
    out property <duration> pour-step: 40ms;

    // Radii and the islands' distance from the window's edge.
    out property <length> radius-island: 8px;
    out property <length> radius-control: 6px;

    // The canvas scroll bar.
    out property <color> scroll-track: dark ? #ffffff0d : #0000000d;
    out property <color> scroll-thumb: dark ? #71717a : #9ca3af;
    out property <color> scroll-thumb-pressed: dark ? #a1a1aa : #6b7280;
}
