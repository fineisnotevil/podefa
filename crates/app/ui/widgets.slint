// The pieces the islands are built from (Plan 0007 Phase 2): the island surface, icon buttons,
// menu rows and separators. Every one takes its colours from `Theme`.

import { Theme } from "theme.slint";

// A surface floating over the canvas. Opaque: Slint has no backdrop blur (Plan 0007 §3.2), and
// the surface ladder keeps it apart from the canvas where the renderer draws no shadow.
export component Island inherits Rectangle {
    background: Theme.surface-float;
    border-radius: Theme.radius-island;
    border-width: 1px;
    border-color: Theme.island-line;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.island-shadow;
}

// A square button with an icon. Clicks do not take the keyboard from the canvas; Tab reaches it,
// and Enter or Space presses it. `tip` is its tooltip: the command's name and its shortcut.
export component IconButton inherits FocusScope {
    in property <image> icon;
    in property <string> tip;
    in property <bool> checked: false;
    in property <length> icon-size: 16px;
    // The icon's colour when it is neither checked nor under the pointer.
    in property <color> tint: Theme.text-muted;
    // The fill and the icon's colour when checked; the danger red for the window's close button
    // on hover.
    in property <brush> checked-fill: Theme.active;
    in property <color> checked-tint: Theme.text;
    in property <bool> danger: false;
    callback clicked();

    property <bool> keyboard-focus: false;
    width: 32px;
    height: 32px;
    focus-on-click: false;
    focus-gained(reason) => { self.keyboard-focus = reason == FocusReason.tab-navigation; }
    focus-lost => { self.keyboard-focus = false; }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.clicked();
            return accept;
        }
        return reject;
    }

    Rectangle {
        border-radius: Theme.radius-control;
        background: root.danger && touch.has-hover && root.enabled ? Theme.danger-fill
            : root.checked ? root.checked-fill
            : touch.pressed && root.enabled ? Theme.active
            : touch.has-hover && root.enabled ? Theme.hover : transparent;
        border-width: root.keyboard-focus ? 2px : 0px;
        border-color: Theme.focus;
        animate background { duration: Theme.fade; }
        Image {
            source: root.icon;
            width: root.icon-size;
            height: root.icon-size;
            colorize: root.danger && touch.has-hover && root.enabled ? #ffffff
                : root.checked ? root.checked-tint
                : touch.has-hover && root.enabled ? Theme.text : root.tint;
            opacity: root.enabled ? 1.0 : 0.35;
        }
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
        Tooltip { text: @markdown("\{root.tip}"); }
    }
}

// A thin line between groups of buttons in an island.
export component Separator inherits Rectangle {
    in property <bool> vertical: false;
    width: vertical ? 1px : 20px;
    height: vertical ? 20px : 1px;
    background: Theme.line-strong;
}

// A row in a popup menu: an icon, the label, the shortcut and, for a choice, a tick.
export component MenuRow inherits FocusScope {
    in property <image> icon;
    in property <string> label;
    in property <string> shortcut;
    in property <bool> checkable: false;
    in property <bool> checked: false;
    callback activated();

    property <bool> keyboard-focus: false;
    height: 30px;
    focus-on-click: false;
    focus-gained(reason) => { self.keyboard-focus = reason != FocusReason.pointer-click; }
    focus-lost => { self.keyboard-focus = false; }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.activated();
            return accept;
        }
        return reject;
    }

    Rectangle {
        border-radius: Theme.radius-control;
        background: (touch.has-hover || root.keyboard-focus) && root.enabled ? Theme.hover : transparent;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Rectangle {
                width: 14px;
                Image {
                    visible: !root.checkable || root.checked;
                    source: root.checkable ? @image-url("icons/check.svg") : root.icon;
                    width: 14px;
                    height: 14px;
                    colorize: root.checkable ? Theme.text : Theme.text-muted;
                }
            }
            Text {
                text: root.label;
                color: Theme.text;
                opacity: root.enabled ? 1.0 : 0.4;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.shortcut != "" : Text {
                text: root.shortcut;
                color: Theme.text-faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.activated(); }
        }
    }
}

// A popup menu's surface. The menu's `PopupWindow` holds one of these, with its rows inside.
export component MenuSurface inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-island;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: Theme.shadow;
}

// A small heading inside a menu.
export component MenuHeading inherits Text {
    color: Theme.text-faint;
    font-size: 11px;
    height: 22px;
    vertical-alignment: center;
}

// A one-line text box (in place of the style's LineEdit). On Android the keyboard's word in
// progress (its composition) reaches Slint 1.18.1 as wholly selected
// (i-slint-backend-android-activity `javahelper.rs:616`), so the word being typed showed as a
// selection; here a composition is drawn as plain text.
export component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled <=> input.enabled;
    in property <bool> read-only <=> input.read-only;
    in property <InputType> input-type <=> input.input-type;
    in property <length> font-size: 13px;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    public function select-all() {
        input.select-all();
    }

    property <bool> composing: input.preedit-text != "";
    // The text slides left so the cursor stays in the box.
    property <length> scroll: 0px;

    min-width: 40px;
    min-height: 32px;
    border-radius: 6px;
    background: root.enabled && !root.read-only ? Theme.surface : Theme.hover;
    border-width: 1px;
    border-color: input.has-focus ? Theme.focus : Theme.line-strong;
    forward-focus: input;

    clip-area := Rectangle {
        x: 8px;
        width: parent.width - 16px;
        clip: true;
        if root.text == "" && !root.composing : Text {
            width: parent.width;
            height: parent.height;
            text: root.placeholder-text;
            font-size: root.font-size;
            color: Theme.text-faint;
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            x: min(0px, max(parent.width - self.width, root.scroll));
            width: max(parent.width, self.preferred-width + self.text-cursor-width);
            height: parent.height;
            single-line: true;
            vertical-alignment: center;
            font-size: root.font-size;
            color: root.enabled ? Theme.text : Theme.text-faint;
            selection-background-color: root.composing ? transparent : Theme.selection;
            selection-foreground-color: root.composing ? Theme.text : Theme.selection-text;
            cursor-position-changed(position) => {
                if (position.x + root.scroll < 0px) {
                    root.scroll = -position.x;
                } else if (position.x + root.scroll > clip-area.width - self.text-cursor-width) {
                    root.scroll = clip-area.width - self.text-cursor-width - position.x;
                }
            }
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }
    }
}

// A dialog's button (Plan 0007 Phase 5, the concept's dialogs): an outlined one, a filled
// `primary` one for the dialog's action, or a choice (`checkable`) whose checked state is filled
// like the primary. Clicks do not take the keyboard; Tab reaches it, Enter or Space presses it.
export component DialogButton inherits FocusScope {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> checkable: false;
    in property <bool> checked: false;
    in property <image> icon;
    callback clicked();

    property <bool> keyboard-focus: false;
    property <bool> filled: root.primary || (root.checkable && root.checked);
    min-height: 30px;
    min-width: label.preferred-width + 24px + (root.icon.width > 0 ? 20px : 0px);
    preferred-width: self.min-width;
    focus-on-click: false;
    focus-gained(reason) => { self.keyboard-focus = reason == FocusReason.tab-navigation; }
    focus-lost => { self.keyboard-focus = false; }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == " ") {
            root.clicked();
            return accept;
        }
        return reject;
    }

    Rectangle {
        border-radius: Theme.radius-control;
        background: root.filled ? (touch.pressed ? Theme.text-muted : Theme.text)
            : touch.pressed && root.enabled ? Theme.active
            : touch.has-hover && root.enabled ? Theme.hover : transparent;
        border-width: root.keyboard-focus ? 2px : root.filled ? 0px : 1px;
        border-color: root.keyboard-focus ? Theme.focus : Theme.line-strong;
        opacity: root.enabled ? 1.0 : 0.4;
        animate background { duration: Theme.fade; }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            label := Text {
                text: root.text;
                font-size: 12px;
                font-weight: root.filled ? 600 : 500;
                color: root.filled ? Theme.surface : Theme.text;
                vertical-alignment: center;
            }
            if root.icon.width > 0 : Image {
                y: (parent.height - self.height) / 2;
                source: root.icon;
                width: 14px;
                height: 14px;
                colorize: root.filled ? Theme.surface : Theme.text;
            }
        }
        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
    }
}

// The surface of a dialog or a tool's sheet: an island card a little raised over the window.
export component DialogSurface inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-island;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;
}

// A modal dialog (Plan 0007 Phase 5): the window dimmed under a scrim, and in its middle a card
// with a title row and its close button; what the dialog holds goes under the title. Escape or
// the close button send `closed`; a click on the scrim does nothing, so a half-typed answer is
// not lost by a stray click.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 360px;
    callback closed();

    background: Theme.scrim;
    TouchArea {}
    FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.closed();
                return accept;
            }
            return reject;
        }
        card := DialogSurface {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(root.width - 32px, root.card-width);
            height: min(root.height - 32px, column.preferred-height);
            clip: true;
            TouchArea {}
            column := VerticalLayout {
                HorizontalLayout {
                    height: 36px;
                    padding-left: 14px;
                    padding-right: 4px;
                    Text {
                        text: root.title;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        icon: @image-url("icons/x.svg");
                        icon-size: 14px;
                        tip: "Close (Esc)";
                        clicked => { root.closed(); }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                @children
            }
        }
    }
}
