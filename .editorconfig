root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.slint]
indent_size = 4

[Makefile]
indent_style = tab
